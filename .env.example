# Door County Visitor - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# Supabase Configuration
# =============================================================================

# Project URL (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Anon/Public Key (safe for client-side, has RLS restrictions)
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (server-side only, bypasses RLS - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# GoHighLevel Configuration
# =============================================================================

# Private Integration Token (pit-xxxxx format)
# Get this from: GHL > Settings > Private Integrations > Create New
GHL_API_TOKEN=pit-your-private-integration-token-here

# Location ID
# Get this from: GHL > Settings > Company > Your location ID in URL
GHL_LOCATION_ID=your_location_id_here

# =============================================================================
# Site Configuration
# =============================================================================

# Production URL
SITE_URL=https://doorcountyvisitor.com

# Environment (development, staging, production)
NODE_ENV=development

# =============================================================================
# Optional: Analytics & Tracking
# =============================================================================

# Google Analytics 4
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification
# GOOGLE_SITE_VERIFICATION=your_verification_code

# =============================================================================
# Optional: Third-party APIs
# =============================================================================

# Google Maps API Key (for maps integration)
# GOOGLE_MAPS_API_KEY=your_google_maps_key

# OpenWeather API (for weather widget)
# OPENWEATHER_API_KEY=your_openweather_key
