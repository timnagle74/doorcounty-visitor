# Door County Visitor - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# GoHighLevel Configuration
# =============================================================================

# Private Integration API Key
# Get this from: GHL > Settings > Private Integrations > Create New
GHL_API_KEY=your_private_integration_key_here

# Location ID  
# Get this from: GHL > Settings > Company > Your location ID in URL
GHL_LOCATION_ID=your_location_id_here

# GHL API Base URL (don't change unless using different region)
GHL_BASE_URL=https://services.leadconnectorhq.com

# =============================================================================
# Site Configuration
# =============================================================================

# Production URL
SITE_URL=https://doorcountyvisitor.com

# Environment (development, staging, production)
NODE_ENV=development

# =============================================================================
# Optional: Analytics & Tracking
# =============================================================================

# Google Analytics 4
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification
# GOOGLE_SITE_VERIFICATION=your_verification_code

# =============================================================================
# Optional: Third-party APIs
# =============================================================================

# Google Maps API Key (for maps integration)
# GOOGLE_MAPS_API_KEY=your_google_maps_key

# OpenWeather API (for weather widget)
# OPENWEATHER_API_KEY=your_openweather_key
