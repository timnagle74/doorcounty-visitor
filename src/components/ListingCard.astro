---
import type { Listing } from '../lib/supabase';

// Support both Supabase format and legacy JSON format
interface Props {
  listing: Listing | any;
  category: 'eat' | 'stay' | 'do' | 'shop';
}

const { listing, category } = Astro.props;

const typeLabels: Record<string, string> = {
  restaurant: 'Restaurant',
  lodging_resort: 'Resort',
  lodging_hotel: 'Hotel',
  lodging_bnb: 'B&B',
  lodging_cabin: 'Cabin',
  lodging_vacation_rental: 'Vacation Rental',
  park: 'Park',
  attraction: 'Attraction',
  activity: 'Activity',
  shop: 'Shop',
  gallery: 'Gallery',
};

// Normalize data from either format
const slug = listing.slug;
const name = listing.name;
const type = listing.type;
const subcategories = listing.subcategories || [];

// Description - Supabase uses description_short, JSON uses description.short
const descriptionShort = listing.description_short || listing.description?.short || '';

// Location - Supabase uses city, JSON uses location.cityDisplay
const cityDisplay = listing.city || listing.location?.cityDisplay || '';

// Images - Supabase uses image_primary, JSON uses images.primary
const imagePrimary = listing.image_primary || listing.images?.primary || null;

// Ratings - Supabase uses rating_aggregate/rating_count, JSON uses ratings.aggregate/count
const ratingAggregate = listing.rating_aggregate || listing.ratings?.aggregate || null;
const ratingCount = listing.rating_count || listing.ratings?.count || 0;

// Restaurant data - Supabase uses restaurant_data JSONB, JSON uses restaurant object
const restaurantData = listing.restaurant_data || listing.restaurant || null;
const lodgingData = listing.lodging_data || listing.lodging || null;

const priceRange = restaurantData?.priceRange || lodgingData?.priceRange || null;
const hasFishBoil = restaurantData?.hasFishBoil || false;
const cuisines = restaurantData?.cuisines || [];

// Tier/Verified - Supabase uses tier/is_verified, JSON uses listing.tier/verified
const tier = listing.tier || listing.listing?.tier || 'free';
const isVerified = listing.is_verified ?? listing.listing?.verified ?? false;
const isFeatured = tier === 'featured';
---

<a
  href={`/${category}/${slug}`}
  class:list={[
    "group block bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300",
    isFeatured && "ring-2 ring-dc-cherry-500"
  ]}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-dc-sand-200">
    {imagePrimary ? (
      <img
        src={imagePrimary}
        alt={name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-16 h-16 text-dc-sand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-2">
      {isFeatured && (
        <span class="badge-featured">Featured</span>
      )}
      {isVerified && !isFeatured && (
        <span class="badge-verified">Verified</span>
      )}
      {hasFishBoil && (
        <span class="bg-dc-cherry-500 text-white text-xs font-medium px-2 py-1 rounded-full">
          Fish Boil
        </span>
      )}
    </div>

    <!-- Price Range -->
    {priceRange && (
      <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-dc-lake-700 text-sm font-medium px-2 py-1 rounded">
        {priceRange}
      </div>
    )}
  </div>

  <div class="p-4">
    <!-- Type & Location -->
    <div class="flex items-center gap-2 text-sm text-dc-lake-600 mb-2">
      <span>{typeLabels[type] || type}</span>
      <span class="text-dc-sand-400">•</span>
      <span>{cityDisplay}</span>
    </div>

    <!-- Name -->
    <h3 class="font-display text-lg font-semibold text-dc-lake-800 group-hover:text-dc-cherry-600 transition-colors mb-2">
      {name}
    </h3>

    <!-- Description -->
    <p class="text-dc-lake-600 text-sm line-clamp-2 mb-3">
      {descriptionShort}
    </p>

    <!-- Rating & Cuisines -->
    <div class="flex items-center justify-between">
      {ratingAggregate && (
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4 text-dc-cherry-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="text-sm font-medium text-dc-lake-800">{ratingAggregate}</span>
          <span class="text-sm text-dc-lake-500">({ratingCount})</span>
        </div>
      )}

      {cuisines.length > 0 && (
        <div class="text-xs text-dc-lake-500">
          {cuisines.slice(0, 2).join(' • ')}
        </div>
      )}
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
