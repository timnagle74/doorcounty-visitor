---
// src/pages/contact.astro
// Contact page with contact form

import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { generateBreadcrumbSchema } from '@/lib/schema';

const title = 'Contact Us';
const description = 'Get in touch with Door County Visitor. We\'re here to help with trip planning, business inquiries, and any questions about Door County, Wisconsin.';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://doorcountyvisitor.com/' },
  { name: 'Contact', url: 'https://doorcountyvisitor.com/contact' },
]);
---

<BaseLayout title={title} description={description} schema={breadcrumbSchema}>
  <!-- Hero Section -->
  <section class="bg-dc-lake-800 text-white py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">Get in Touch</h1>
        <p class="text-xl text-dc-sand-200">
          Have a question about Door County? Planning a trip? We'd love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-xl shadow-soft p-6 md:p-8">
            <h2 class="text-2xl font-display font-bold text-dc-lake-800 mb-6">Send Us a Message</h2>
            <ContactForm />
          </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
          <!-- Quick Contact -->
          <div class="bg-white rounded-xl shadow-soft p-6">
            <h3 class="text-lg font-display font-bold text-dc-lake-800 mb-4">Quick Contact</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-dc-cherry-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div>
                  <span class="block text-sm text-dc-lake-600">Email</span>
                  <a href="mailto:hello@doorcountyvisitor.com" class="text-dc-lake-800 hover:text-dc-cherry-600 transition-colors">
                    hello@doorcountyvisitor.com
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Business Inquiries -->
          <div class="bg-dc-lake-50 rounded-xl p-6">
            <h3 class="text-lg font-display font-bold text-dc-lake-800 mb-3">Business Owner?</h3>
            <p class="text-dc-lake-600 text-sm mb-4">
              Want to list your business on Door County Visitor? We'd love to feature you.
            </p>
            <a
              href="https://doorcounty.io"
              class="inline-flex items-center gap-2 text-dc-cherry-600 hover:text-dc-cherry-700 font-medium text-sm transition-colors"
            >
              List Your Business
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <!-- Response Time -->
          <div class="bg-dc-forest-50 rounded-xl p-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dc-forest-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h3 class="font-medium text-dc-lake-800">Response Time</h3>
                <p class="text-sm text-dc-lake-600 mt-1">
                  We typically respond within 24-48 hours during business days.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
