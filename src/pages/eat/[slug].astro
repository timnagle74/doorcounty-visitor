---
// src/pages/eat/[slug].astro
// Individual restaurant detail page

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListing, getListings } from '../../lib/supabase';
import { generateListingSchemaFromSupabase, generateBreadcrumbSchema } from '../../lib/schema';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/eat');
}

const listing = await getListing('door-county', slug);

if (!listing) {
  return Astro.redirect('/eat');
}

// Get related restaurants from same city
const relatedListings = await getListings('door-county', {
  type: 'restaurant',
  limit: 4
});
const related = relatedListings
  .filter(r => r.slug !== slug && r.city === listing.city)
  .slice(0, 3);

// Generate schemas
const listingSchema = generateListingSchemaFromSupabase(listing, 'eat');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://doorcountyvisitor.com' },
  { name: 'Where to Eat', url: 'https://doorcountyvisitor.com/eat' },
  { name: listing.name, url: `https://doorcountyvisitor.com/eat/${slug}` },
]);

const title = `${listing.name} | Door County Restaurant`;
const description = listing.description_short || `Visit ${listing.name} in ${listing.city}, Door County, Wisconsin.`;

// Parse hours
const hours = listing.hours as Record<string, string> | null;
const restaurantData = listing.restaurant_data;

const dayOrder = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
const dayLabels: Record<string, string> = {
  monday: 'Mon',
  tuesday: 'Tue',
  wednesday: 'Wed',
  thursday: 'Thu',
  friday: 'Fri',
  saturday: 'Sat',
  sunday: 'Sun'
};
---

<BaseLayout title={title} description={description} schema={[listingSchema, breadcrumbSchema]}>
  <!-- Hero Section with Image -->
  <section class="relative bg-dc-lake-900">
    <div class="absolute inset-0">
      {listing.image_primary ? (
        <img
          src={listing.image_primary}
          alt={listing.name}
          class="w-full h-full object-cover opacity-40"
        />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-dc-lake-700 to-dc-lake-900"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-dc-lake-900 via-dc-lake-900/50 to-transparent"></div>
    </div>

    <div class="container-wide relative py-16 md:py-24">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-dc-sand-300">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="text-dc-sand-500">/</span></li>
          <li><a href="/eat" class="hover:text-white transition-colors">Where to Eat</a></li>
          <li><span class="text-dc-sand-500">/</span></li>
          <li class="text-white">{listing.name}</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <!-- Badges -->
        <div class="flex flex-wrap gap-2 mb-4">
          {listing.tier === 'featured' && (
            <span class="badge-featured">Featured</span>
          )}
          {listing.is_verified && listing.tier !== 'featured' && (
            <span class="badge-verified">Verified</span>
          )}
          {restaurantData?.hasFishBoil && (
            <span class="bg-dc-cherry-500 text-white text-xs font-medium px-3 py-1 rounded-full">
              Fish Boil
            </span>
          )}
        </div>

        <!-- Name & Location -->
        <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-4">
          {listing.name}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-dc-sand-200 mb-6">
          {listing.city && (
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {listing.city}, WI
            </span>
          )}
          {restaurantData?.priceRange && (
            <span class="flex items-center gap-2">
              <span class="text-dc-cherry-400 font-medium">{restaurantData.priceRange}</span>
            </span>
          )}
          {listing.rating_aggregate && (
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-dc-cherry-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <span class="font-medium text-white">{listing.rating_aggregate}</span>
              <span class="text-dc-sand-400">({listing.rating_count} reviews)</span>
            </span>
          )}
        </div>

        <!-- Cuisines -->
        {restaurantData?.cuisines && restaurantData.cuisines.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {restaurantData.cuisines.map((cuisine: string) => (
              <span class="bg-white/10 text-dc-sand-200 text-sm px-3 py-1 rounded-full">
                {cuisine}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Main Column -->
        <div class="lg:col-span-2 space-y-8">
          <!-- About -->
          <div class="bg-white rounded-xl shadow-soft p-6 md:p-8">
            <h2 class="text-2xl font-display font-bold text-dc-lake-800 mb-4">About</h2>
            <div class="prose prose-lg text-dc-lake-700">
              {listing.description_full ? (
                <p>{listing.description_full}</p>
              ) : listing.description_short ? (
                <p>{listing.description_short}</p>
              ) : (
                <p class="text-dc-lake-500 italic">No description available.</p>
              )}
            </div>

            <!-- Dietary Options -->
            {restaurantData?.dietaryOptions && restaurantData.dietaryOptions.length > 0 && (
              <div class="mt-6 pt-6 border-t border-dc-sand-200">
                <h3 class="text-sm font-medium text-dc-lake-600 mb-3">Dietary Options</h3>
                <div class="flex flex-wrap gap-2">
                  {restaurantData.dietaryOptions.map((option: string) => (
                    <span class="bg-dc-forest-100 text-dc-forest-700 text-sm px-3 py-1 rounded-full">
                      {option}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Hours -->
          {hours && Object.keys(hours).length > 0 && (
            <div class="bg-white rounded-xl shadow-soft p-6 md:p-8">
              <h2 class="text-2xl font-display font-bold text-dc-lake-800 mb-4">Hours</h2>
              <div class="grid grid-cols-2 gap-2">
                {dayOrder.map(day => hours[day] && (
                  <div class="flex justify-between py-2 border-b border-dc-sand-100">
                    <span class="font-medium text-dc-lake-700">{dayLabels[day]}</span>
                    <span class="text-dc-lake-600">{hours[day]}</span>
                  </div>
                ))}
              </div>
              {listing.hours_notes && (
                <p class="mt-4 text-sm text-dc-lake-500 italic">{listing.hours_notes}</p>
              )}
            </div>
          )}

          <!-- Image Gallery Placeholder -->
          {listing.image_gallery && listing.image_gallery.length > 0 && (
            <div class="bg-white rounded-xl shadow-soft p-6 md:p-8">
              <h2 class="text-2xl font-display font-bold text-dc-lake-800 mb-4">Photos</h2>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {listing.image_gallery.map((img: string, i: number) => (
                  <div class="aspect-square rounded-lg overflow-hidden bg-dc-sand-200">
                    <img src={img} alt={`${listing.name} photo ${i + 1}`} class="w-full h-full object-cover" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Contact Card -->
          <div class="bg-white rounded-xl shadow-soft p-6 sticky top-24">
            <h3 class="text-lg font-display font-bold text-dc-lake-800 mb-4">Contact & Location</h3>

            <div class="space-y-4">
              {listing.address && (
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-dc-lake-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <div>
                    <p class="text-dc-lake-800">{listing.address}</p>
                    <p class="text-dc-lake-600">{listing.city}, {listing.state} {listing.zip}</p>
                  </div>
                </div>
              )}

              {listing.phone && (
                <a href={`tel:${listing.phone}`} class="flex items-center gap-3 text-dc-lake-800 hover:text-dc-cherry-600 transition-colors">
                  <svg class="w-5 h-5 text-dc-lake-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  {listing.phone}
                </a>
              )}

              {listing.email && (
                <a href={`mailto:${listing.email}`} class="flex items-center gap-3 text-dc-lake-800 hover:text-dc-cherry-600 transition-colors">
                  <svg class="w-5 h-5 text-dc-lake-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  Email
                </a>
              )}

              {listing.website && (
                <a href={listing.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-dc-lake-800 hover:text-dc-cherry-600 transition-colors">
                  <svg class="w-5 h-5 text-dc-lake-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                  Visit Website
                </a>
              )}
            </div>

            <!-- Action Buttons -->
            <div class="mt-6 space-y-3">
              {listing.website && (
                <a
                  href={listing.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary w-full text-center"
                >
                  {restaurantData?.acceptsReservations ? 'Make Reservation' : 'Visit Website'}
                </a>
              )}

              {restaurantData?.menuUrl && (
                <a
                  href={restaurantData.menuUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary w-full text-center"
                >
                  View Menu
                </a>
              )}
            </div>

            <!-- Social Links -->
            {(listing.social_facebook || listing.social_instagram || listing.social_tripadvisor) && (
              <div class="mt-6 pt-6 border-t border-dc-sand-200">
                <p class="text-sm text-dc-lake-600 mb-3">Follow</p>
                <div class="flex gap-3">
                  {listing.social_facebook && (
                    <a href={listing.social_facebook} target="_blank" rel="noopener noreferrer" class="text-dc-lake-500 hover:text-dc-cherry-600 transition-colors" aria-label="Facebook">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
                      </svg>
                    </a>
                  )}
                  {listing.social_instagram && (
                    <a href={listing.social_instagram} target="_blank" rel="noopener noreferrer" class="text-dc-lake-500 hover:text-dc-cherry-600 transition-colors" aria-label="Instagram">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                      </svg>
                    </a>
                  )}
                  {listing.social_tripadvisor && (
                    <a href={listing.social_tripadvisor} target="_blank" rel="noopener noreferrer" class="text-dc-lake-500 hover:text-dc-cherry-600 transition-colors" aria-label="TripAdvisor">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>

          <!-- Claim Listing CTA -->
          {!listing.is_verified && (
            <div class="bg-dc-lake-50 rounded-xl p-6">
              <h3 class="font-display font-bold text-dc-lake-800 mb-2">Own this business?</h3>
              <p class="text-sm text-dc-lake-600 mb-4">Claim your listing to update information and respond to reviews.</p>
              <button
                id="claim-btn"
                data-business-name={listing.name}
                data-business-slug={slug}
                class="btn-secondary w-full text-center text-sm"
              >
                Claim This Listing
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Related Restaurants -->
  {related.length > 0 && (
    <section class="section bg-dc-sand-50">
      <div class="container-wide">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-dc-lake-800 mb-8">
          More Restaurants in {listing.city}
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map(r => (
            <a href={`/eat/${r.slug}`} class="group bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-all">
              <div class="aspect-[4/3] bg-dc-sand-200 overflow-hidden">
                {r.image_primary ? (
                  <img src={r.image_primary} alt={r.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-dc-sand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                <h3 class="font-display font-semibold text-dc-lake-800 group-hover:text-dc-cherry-600 transition-colors">{r.name}</h3>
                <p class="text-sm text-dc-lake-600 mt-1 line-clamp-2">{r.description_short}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Claim Modal -->
  <div id="claim-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" id="modal-backdrop"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative">
        <button id="close-modal" class="absolute top-4 right-4 text-dc-lake-500 hover:text-dc-lake-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h3 class="text-xl font-display font-bold text-dc-lake-800 mb-2">Claim Your Listing</h3>
        <p class="text-dc-lake-600 text-sm mb-6">Fill out the form below and we'll verify your ownership of <strong id="modal-business-name"></strong>.</p>

        <form id="claim-form" class="space-y-4">
          <input type="hidden" name="businessSlug" id="form-business-slug" />
          <input type="hidden" name="businessName" id="form-business-name" />

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-dc-lake-700 mb-1">First Name *</label>
              <input type="text" name="firstName" required class="w-full px-3 py-2 border border-dc-sand-300 rounded-lg focus:ring-2 focus:ring-dc-lake-500 focus:border-dc-lake-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-dc-lake-700 mb-1">Last Name</label>
              <input type="text" name="lastName" class="w-full px-3 py-2 border border-dc-sand-300 rounded-lg focus:ring-2 focus:ring-dc-lake-500 focus:border-dc-lake-500" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-dc-lake-700 mb-1">Email *</label>
            <input type="email" name="email" required class="w-full px-3 py-2 border border-dc-sand-300 rounded-lg focus:ring-2 focus:ring-dc-lake-500 focus:border-dc-lake-500" />
          </div>

          <div>
            <label class="block text-sm font-medium text-dc-lake-700 mb-1">Phone *</label>
            <input type="tel" name="phone" required class="w-full px-3 py-2 border border-dc-sand-300 rounded-lg focus:ring-2 focus:ring-dc-lake-500 focus:border-dc-lake-500" />
          </div>

          <!-- A2P SMS Consent -->
          <div class="bg-dc-sand-50 rounded-lg p-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="smsConsent" required class="mt-1 w-4 h-4 rounded border-dc-sand-300 text-dc-lake-600 focus:ring-dc-lake-500" />
              <span class="text-sm text-dc-lake-600">
                I consent to receive SMS messages from doorcounty.io regarding my business listing claim. Message & data rates may apply. Reply STOP to unsubscribe.
                <a href="/privacy" class="text-dc-lake-700 underline hover:text-dc-cherry-600">Privacy Policy</a>
              </span>
            </label>
          </div>

          <div id="claim-message" class="hidden p-3 rounded-lg text-sm"></div>

          <button type="submit" id="claim-submit" class="btn-primary w-full">
            <span id="claim-btn-text">Submit Claim Request</span>
            <span id="claim-btn-loading" class="hidden">
              <svg class="animate-spin inline-block w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Submitting...
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const claimBtn = document.getElementById('claim-btn');
  const claimModal = document.getElementById('claim-modal');
  const closeModal = document.getElementById('close-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalBusinessName = document.getElementById('modal-business-name');
  const formBusinessSlug = document.getElementById('form-business-slug') as HTMLInputElement;
  const formBusinessName = document.getElementById('form-business-name') as HTMLInputElement;
  const claimForm = document.getElementById('claim-form') as HTMLFormElement;
  const claimMessage = document.getElementById('claim-message');
  const claimSubmit = document.getElementById('claim-submit') as HTMLButtonElement;
  const claimBtnText = document.getElementById('claim-btn-text');
  const claimBtnLoading = document.getElementById('claim-btn-loading');

  function openModal() {
    if (!claimBtn || !claimModal) return;
    const businessName = claimBtn.dataset.businessName || '';
    const businessSlug = claimBtn.dataset.businessSlug || '';

    if (modalBusinessName) modalBusinessName.textContent = businessName;
    if (formBusinessName) formBusinessName.value = businessName;
    if (formBusinessSlug) formBusinessSlug.value = businessSlug;

    claimModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModalFn() {
    if (claimModal) claimModal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  claimBtn?.addEventListener('click', openModal);
  closeModal?.addEventListener('click', closeModalFn);
  modalBackdrop?.addEventListener('click', closeModalFn);

  claimForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (claimSubmit) claimSubmit.disabled = true;
    if (claimBtnText) claimBtnText.classList.add('hidden');
    if (claimBtnLoading) claimBtnLoading.classList.remove('hidden');
    if (claimMessage) claimMessage.classList.add('hidden');

    const formData = new FormData(claimForm);
    const data = {
      type: 'claim',
      firstName: formData.get('firstName'),
      lastName: formData.get('lastName'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      businessName: formData.get('businessName'),
      businessSlug: formData.get('businessSlug'),
      smsConsent: formData.get('smsConsent') === 'on',
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (claimMessage) {
        claimMessage.classList.remove('hidden', 'bg-dc-forest-100', 'text-dc-forest-800', 'bg-dc-cherry-100', 'text-dc-cherry-800');
        if (result.success) {
          claimMessage.classList.add('bg-dc-forest-100', 'text-dc-forest-800');
          claimMessage.textContent = 'Thank you! We\'ll review your claim and get back to you soon.';
          claimForm.reset();
        } else {
          claimMessage.classList.add('bg-dc-cherry-100', 'text-dc-cherry-800');
          claimMessage.textContent = result.error || 'Something went wrong. Please try again.';
        }
      }
    } catch (error) {
      if (claimMessage) {
        claimMessage.classList.remove('hidden');
        claimMessage.classList.add('bg-dc-cherry-100', 'text-dc-cherry-800');
        claimMessage.textContent = 'Unable to submit. Please try again later.';
      }
    } finally {
      if (claimSubmit) claimSubmit.disabled = false;
      if (claimBtnText) claimBtnText.classList.remove('hidden');
      if (claimBtnLoading) claimBtnLoading.classList.add('hidden');
    }
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModalFn();
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
